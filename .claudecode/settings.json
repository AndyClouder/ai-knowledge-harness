{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/on_write_json.py",
            "timeout": 30,
            "statusMessage": "Validating JSON..."
          }
        ]
      }
    ]
  }
}
