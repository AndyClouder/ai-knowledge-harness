{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalyzedArticle",
  "description": "Analyzer 产出的分析后数据格式，每个文件为一个 JSON 数组",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "source_url", "source", "collected_at", "summary", "tags", "status", "published_at", "metadata", "analysis"],
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid",
        "description": "唯一标识（UUID v4）"
      },
      "title": {
        "type": "string",
        "description": "项目/文章标题",
        "minLength": 1
      },
      "source_url": {
        "type": "string",
        "format": "uri",
        "description": "原文链接"
      },
      "source": {
        "type": "string",
        "enum": ["github_trending", "hacker_news"],
        "description": "数据来源"
      },
      "collected_at": {
        "type": "string",
        "format": "date-time",
        "description": "采集时间（ISO 8601）"
      },
      "summary": {
        "type": "string",
        "description": "简要描述（来自 collector）",
        "minLength": 1
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "领域标签"
      },
      "status": {
        "type": "string",
        "enum": ["raw", "analyzed", "published"],
        "description": "处理状态"
      },
      "published_at": {
        "type": ["string", "null"],
        "format": "date-time",
        "description": "分发时间"
      },
      "metadata": {
        "type": "object",
        "required": ["stars", "score", "author", "language"],
        "properties": {
          "stars": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "GitHub Stars 总数"
          },
          "stars_today": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "今日新增 Stars"
          },
          "score": {
            "type": ["integer", "null"],
            "description": "HN 得分"
          },
          "author": {
            "type": ["string", "null"],
            "description": "作者"
          },
          "language": {
            "type": ["string", "null"],
            "description": "编程语言"
          }
        }
      },
      "analysis": {
        "type": "object",
        "required": ["summary_cn", "highlights", "score", "score_reason", "suggested_tags", "target_audience"],
        "properties": {
          "summary_cn": {
            "type": "string",
            "minLength": 50,
            "maxLength": 300,
            "description": "中文摘要（150-200 字）"
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 3,
            "description": "关键亮点（1-3 条）"
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "质量评分（1-10）"
          },
          "score_reason": {
            "type": "string",
            "minLength": 1,
            "description": "评分理由"
          },
          "suggested_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 5,
            "description": "建议标签（2-5 个，小写）"
          },
          "target_audience": {
            "type": "string",
            "minLength": 1,
            "description": "目标受众"
          }
        }
      }
    },
    "additionalProperties": false
  }
}
